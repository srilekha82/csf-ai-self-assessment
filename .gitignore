.venv/
__pycache__/
.DS_Store
# client data
runs/
# CIS material is CC BY-NC-ND 4.0: internal non-commercial use only, do not redistribute
data/ai/source/*.pdf
# except the NIST AI RMF Playbook: a US government work, not under copyright, so it is committed
!data/ai/source/AI_RMF_Playbook.pdf
data/ai/source/*.xlsx
# CIS safeguard text (CC BY-NC-ND 4.0): made locally by parse_ai_rmf_sources.py; the ids-only file is committed
data/ai/cis_ai_safeguards.json

# run logs: written by the scripts on every run, not part of the code
audit.jsonl
judgement_log/
# except the AI bank build's: the record of every agent decision behind the banks (agent output and hashes,
# no CIS text: inputs are referenced by path and hash only)
!data/ai/bank_build/judgement_log/
# temporary bank build files (prepared inputs, agent drafts, verdicts): deleted at the end of a build
data/*/bank_build/work/
